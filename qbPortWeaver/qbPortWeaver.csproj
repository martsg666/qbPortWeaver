<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>qbPortWeaver.ico</ApplicationIcon>
    <AssemblyTitle>qbPortWeaver</AssemblyTitle>
    <Description>Syncs the listening port of qBittorrent with the port assigned by your VPN provider (ProtonVPN, PIA, or any NAT-PMP capable adapter)</Description>
    <Company>martsg666</Company>
    <Product>qbPortWeaver</Product>
    <Authors>martsg666</Authors>
    <Copyright>© 2026 martsg666</Copyright>
    <Version>2.5.0</Version>
    <FileVersion>2.5.0.0</FileVersion>
    <AssemblyVersion>2.5.0.0</AssemblyVersion>
    <SignAssembly>False</SignAssembly>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Suppress known SonarAnalyzer false positives (each has a matching // NOSONAR comment):
         S108  - empty catch bodies are intentional (AppConstants.cs, BitTorrentClientBase.cs, TransmissionClient.cs)
         S1075 - TMDB base URL is intentionally hardcoded (TmdbClient.cs)
         S2068 - registry key name contains "Password", value is masked (PortSyncService.cs)
         S2221 - bare catch before LogManager is initialized; any failure must fall back safely (Program.cs)
         S2486 - same as S108, SonarCloud cloud rule counterpart (AppConstants.cs, BitTorrentClientBase.cs, TransmissionClient.cs)
         S3881 - abstract base class; all sealed subclasses have no additional disposable resources (BitTorrentClientBase.cs)
         S4721 - post-update command is user-configured, arbitrary execution is intended (PortSyncService.cs)
         S4790 - TMDB credential sent over HTTPS only; v3 API key in query param, v4 JWT as Bearer header (TmdbClient.cs)
         S6966 - non-modal Show() is intentional for WhatsNewForm and UpdateAvailableForm (MainForm.cs) -->
    <NoWarn>S108;S1075;S2068;S2221;S2486;S3881;S4721;S4790;S6966</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.21.0.135717">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="qbPortWeaver.ico">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
