<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>qbPortWeaver.ico</ApplicationIcon>
    <AssemblyTitle>qbPortWeaver</AssemblyTitle>
    <Description>Syncs the listening port of qBittorrent, Transmission, Deluge, or Nicotine+ with the port assigned by your VPN provider (ProtonVPN, PIA, or any NAT-PMP capable gateway)</Description>
    <Company>martsg666</Company>
    <Product>qbPortWeaver</Product>
    <Authors>martsg666</Authors>
    <Copyright>© 2026 martsg666</Copyright>
    <Version>2.6.4</Version>
    <FileVersion>2.6.4.0</FileVersion>
    <AssemblyVersion>2.6.4.0</AssemblyVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <SignAssembly>False</SignAssembly>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Suppress known SonarAnalyzer false positives (each has a matching // NOSONAR comment):
         S108  - empty catch bodies are intentional (ManagedClientBase.cs, TransmissionClient.cs)
         S125  - documentation comments containing qualified identifiers (e.g. Class.Member) are falsely flagged as commented-out code (suppressed project-wide; the rule targets XML doc comments, which cannot carry an inline // NOSONAR)
         S1075 - TMDB base URL is intentionally hardcoded (TmdbClient.cs)
         S1125 - C# pattern matching 'is true' / 'is not true' requires the boolean literal (MediaManagerForm.cs)
         S1215 - intentional GC after explicit large release on log viewer close (LogViewerForm.cs)
         S2068 - registry key name contains "Password", value is masked (PortSyncService.cs)
         S2221 - bare catch before LogManager is initialized; any failure must fall back safely (Program.cs)
         S2325 - handlers/helpers that access instance members (Close, Invoke, ShowBalloonTip, UseWaitCursor/IsDisposed, or a called instance method) cannot be static (AboutForm.cs, DiagnosticsForm.cs, HelpForm.cs, MainForm.cs, MediaManagerForm.cs, PortSyncService.cs, SettingsForm.cs, StatusForm.cs, TransmissionClient.cs, WhatsNewForm.cs)
         S2486 - same as S108, SonarCloud cloud rule counterpart (ManagedClientBase.cs, TransmissionClient.cs)
         S2589 - defensive runtime fallback after a Debug.Assert that only fires in dev builds (WhatsNewForm.cs)
         S2696 - static field written from a single-instance context: the sync-service flag shared with the static manual-test dispatch (PortSyncService.cs) and the process-wide warning dedupe (NicotineClient.cs)
         S3881 - abstract base class; all sealed subclasses have no additional disposable resources (ManagedClientBase.cs)
         S4721 - post-update command is user-configured, arbitrary execution is intended (PortSyncService.cs)
         S4790 - TMDB credential sent over HTTPS only; v3 API key in query param, v4 JWT as Bearer header (TmdbClient.cs)
         S5332 - loopback IPC bridge on 127.0.0.1; TLS is meaningless for a local-only handshake (NicotinePluginDiscovery.cs)
         S6966 - non-modal Show() on child forms is intentional (WhatsNewForm directly; others via the ShowOrActivate helper, MainForm.cs)
         CS1591 - doc *coverage* is deliberately optional; see GenerateDocumentationFile below -->
    <NoWarn>S108;S125;S1075;S1125;S1215;S2068;S2221;S2325;S2486;S2589;S2696;S3881;S4721;S4790;S5332;S6966;CS1591</NoWarn>
    <!-- Enabled for XML doc *accuracy* checking, not to require docs everywhere: without it Roslyn
         never emits CS1574 (unresolvable cref), CS0419 (ambiguous cref), or CS1572/CS1573 (param
         name mismatch), so those rot silently - four broken crefs survived /warnaserror, CI, and
         three review passes before this was switched on. CS1591 (missing doc) is suppressed above so
         coverage stays optional. Combined with /warnaserror in CI, a broken cref now fails the build.
         The generated .xml is not shipped: the MSI names its files explicitly (installer\qbPortWeaver.wxs). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Required by [LibraryImport]: the interop source generator emits `unsafe partial` types into
         obj/.../LibraryImports.g.cs, so the partial classes declaring those imports (MainForm,
         LogViewerForm, MediaImporter) will not compile without it. No `unsafe` keyword appears in
         hand-written source, so removing this looks safe and is not - it fails with SYSLIB1062. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.21.0.135717">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\qbPortWeaver.Shared\qbPortWeaver.Shared.csproj" />
  </ItemGroup>

  <!-- Shared is a foundational dependency (LogLevel, LoggingConstants, HelperProtocol, etc.); make it
       a global using so every file resolves its types without a per-file using directive. The LogLevel
       alias pins the unqualified name to our enum so it cannot be shadowed by another LogLevel in scope
       (e.g. Microsoft.Extensions.Logging.LogLevel, imported by the helper's worker host). -->
  <ItemGroup>
    <Using Include="qbPortWeaver.Shared" />
    <Using Include="qbPortWeaver.Shared.LogLevel" Alias="LogLevel" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The Nicotine+ bridge plugin is embedded rather than shipped as loose files. The app is
       published as a single self-contained executable and the MSI installs only that plus
       README.md, so loose content would need its own installer components and parallel handling in
       the portable and Chocolatey layouts. Embedding keeps one copy and makes Settings' "Install
       plugin" behave identically everywhere. Resource names derive from Link, which
       NicotinePluginInstaller maps back to relative paths.
       The plugin is licensed GPL-3.0-or-later (see plugins\qbpw_nicotine_bridge\LICENSE); it is
       carried here as a separate work, not linked into this assembly's own licence. -->
  <ItemGroup>
    <!-- Exclude Python's bytecode cache: it is build output, is tied to the interpreter version
         that produced it (so it is wrong for whichever Python the user's Nicotine+ runs), and its
         dotted filenames do not survive the resource-name-to-path mapping. -->
    <EmbeddedResource Include="..\plugins\qbpw_nicotine_bridge\**\*"
                      Exclude="..\plugins\qbpw_nicotine_bridge\**\__pycache__\**;..\plugins\qbpw_nicotine_bridge\**\*.pyc"
                      Link="Plugins\Nicotine\qbpw_nicotine_bridge\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="qbPortWeaver.ico">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
      <!-- Copied next to the exe so dev builds match the installed layout; the Help window
           (HelpForm) loads it from AppContext.BaseDirectory. The MSI ships its own copy. -->
      <Link>README.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
