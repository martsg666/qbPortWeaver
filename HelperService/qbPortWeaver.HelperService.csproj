<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>qbPortWeaver Helper Service</AssemblyTitle>
    <Description>Helper for qbPortWeaver - executes privileged session 0 actions on behalf of the user-session tray app</Description>
    <Company>martsg666</Company>
    <Product>qbPortWeaver</Product>
    <Authors>martsg666</Authors>
    <Copyright>© 2026 martsg666</Copyright>
    <Version>2.6.8</Version>
    <FileVersion>2.6.8.0</FileVersion>
    <AssemblyVersion>2.6.8.0</AssemblyVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Suppress known SonarAnalyzer false positives. Each is documented below; per-site
         // NOSONAR comments mark the specific occurrences where the rule permits one
         (S2486 cannot carry one - see its entry):
         S108  - empty catch bodies are intentional (AutoRecovery.cs, HelperPipeServer.cs)
         S2486 - same as S108, SonarCloud cloud rule counterpart (AutoRecovery.cs, HelperPipeServer.cs)
         CS1591 - doc *coverage* is deliberately optional; see GenerateDocumentationFile below -->
    <NoWarn>S108;S2486;CS1591</NoWarn>
    <!-- Enabled for XML doc *accuracy* checking (CS1574 unresolvable cref, CS0419 ambiguous cref,
         CS1572/CS1573 param name mismatch), which Roslyn does not emit at all when this is off.
         CS1591 (missing doc) is suppressed above so coverage stays optional. See qbPortWeaver.csproj. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Required by [LibraryImport] in AutoRecovery (QueryServiceStatusEx): the interop source
         generator emits `unsafe partial` types, so the declaring class will not compile without it.
         No `unsafe` keyword appears in hand-written source, so removing this looks safe and is not. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController"     Version="10.0.0" />
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.21.0.135717">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\qbPortWeaver.Shared\qbPortWeaver.Shared.csproj" />
  </ItemGroup>

  <!-- Shared is a foundational dependency (LogLevel, LoggingConstants, HelperProtocol, etc.); make it
       a global using so every file resolves its types without a per-file using directive. The LogLevel
       alias pins the unqualified name to our enum so it cannot be shadowed by another LogLevel in scope
       (e.g. Microsoft.Extensions.Logging.LogLevel, imported by the helper's worker host). -->
  <ItemGroup>
    <Using Include="qbPortWeaver.Shared" />
    <Using Include="qbPortWeaver.Shared.LogLevel" Alias="LogLevel" />
  </ItemGroup>

</Project>
