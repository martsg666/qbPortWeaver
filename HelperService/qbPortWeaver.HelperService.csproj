<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>qbPortWeaver Helper Service</AssemblyTitle>
    <Description>Helper for qbPortWeaver - executes privileged session 0 actions on behalf of the user-session tray app</Description>
    <Company>martsg666</Company>
    <Product>qbPortWeaver</Product>
    <Authors>martsg666</Authors>
    <Copyright>© 2026 martsg666</Copyright>
    <Version>2.5.5</Version>
    <FileVersion>2.5.5.0</FileVersion>
    <AssemblyVersion>2.5.5.0</AssemblyVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Suppress known SonarAnalyzer false positives (each has a matching // NOSONAR comment):
         S108  - empty catch body is intentional (HelperPipeServer.cs)
         S2486 - same as S108, SonarCloud cloud rule counterpart (HelperPipeServer.cs) -->
    <NoWarn>S108;S2486</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController"     Version="10.0.0" />
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.21.0.135717">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\qbPortWeaver.Shared\qbPortWeaver.Shared.csproj" />
  </ItemGroup>

  <!-- Shared is a foundational dependency (LogLevel, LoggingConstants, HelperProtocol, etc.); make it
       a global using so every file resolves its types without a per-file using directive. The LogLevel
       alias pins the unqualified name to our enum so it cannot be shadowed by another LogLevel in scope
       (e.g. Microsoft.Extensions.Logging.LogLevel, imported by the helper's worker host). -->
  <ItemGroup>
    <Using Include="qbPortWeaver.Shared" />
    <Using Include="qbPortWeaver.Shared.LogLevel" Alias="LogLevel" />
  </ItemGroup>

</Project>
