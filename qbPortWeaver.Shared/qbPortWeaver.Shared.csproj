<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>qbPortWeaver Shared</AssemblyTitle>
    <Description>Constants shared between qbPortWeaver (main app) and qbPortWeaver.HelperService - pipe protocol, registry paths, log column widths.</Description>
    <Company>martsg666</Company>
    <Product>qbPortWeaver</Product>
    <Authors>martsg666</Authors>
    <Copyright>© 2026 martsg666</Copyright>
    <Version>2.6.7</Version>
    <FileVersion>2.6.7.0</FileVersion>
    <AssemblyVersion>2.6.7.0</AssemblyVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- CS1591 - doc *coverage* is deliberately optional; see GenerateDocumentationFile below -->
    <NoWarn>CS1591</NoWarn>
    <!-- Enabled for XML doc *accuracy* checking (CS1574 unresolvable cref, CS0419 ambiguous cref,
         CS1572/CS1573 param name mismatch), which Roslyn does not emit at all when this is off.
         CS1591 (missing doc) is suppressed above so coverage stays optional. See qbPortWeaver.csproj. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.21.0.135717">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
